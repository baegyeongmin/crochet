# Windows에서 상대경로(file:./prisma/dev.db)는 Prisma CLI와 Next.js 런타임이
# 서로 다른 기준 디렉터리로 해석해 "unable to open the database file" 에러가 남.
# 프로젝트 절대경로를 직접 지정할 것 (슬래시는 슬래시 방향 그대로 사용)
DATABASE_URL="file:C:/path/to/crochet/prisma/dev.db"
AUTH_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""

# 도안 이미지 분석기(crochet_rulepart)를 돌릴 파이썬 실행 파일.
# numpy/scipy/pillow 가 설치돼 있어야 한다:
#   python -m venv .venv
#   .venv/Scripts/python.exe -m pip install -r crochet_rulepart/requirements.txt
# 생략하면 PATH 의 "python" 을 쓴다.
PYTHON_BIN="C:/path/to/crochet/.venv/Scripts/python.exe"

# 인식된 도안 문장을 Claude Haiku 로 다듬는 기능(선택).
# 없어도 앱은 정상 동작하고, "AI로 문장 다듬기" 버튼만 비활성화된다.
# 키 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# 모델을 바꾸려면. 생략하면 claude-haiku-4-5-20251001 을 쓴다.
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
